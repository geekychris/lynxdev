#!/usr/bin/env bash
# Run `make` for an Atari Lynx project with the cc65 toolchain: inside the
# toolchain container (docker/Dockerfile, pinned cc65) by default, or
# with a cc65 on PATH when LYNX_NATIVE=1 (or when Docker isn't available).
#
#   bin/lynx-make [-C project_dir] [make args...]
#
# The repo is mounted at /work; projects outside the repo at /project.
source "$(dirname "$0")/../scripts/lib.sh"

proj="$PWD"
if [ "${1:-}" = "-C" ]; then proj="$(cd "$2" && pwd)"; shift 2; fi
[ -f "$proj/Makefile" ] || die "no Makefile in $proj"

native=0
if [ "${LYNX_NATIVE:-}" = 1 ]; then native=1
elif ! { have docker && docker info >/dev/null 2>&1; }; then
  have cl65 || die "no Docker and no cc65 on PATH: start Docker (or install cc65 and set LYNX_NATIVE=1)"
  warn "Docker not available: building with the cc65 on PATH ($(cc65 --version 2>&1 | head -1))"
  native=1
fi
if [ $native = 1 ]; then
  if cc65 --version 2>&1 | grep -qE 'V2\.(1[0-8]|[0-9])([^0-9]|$)'; then
    warn "$(cc65 --version 2>&1 | head -1) is older than the pinned cc65 (2.19 git, $CC65_COMMIT): some SDK features and games build or draw wrong with it; use Docker (unset LYNX_NATIVE)"
  fi
  exec make -C "$proj" LYNX_SDK="$LYNX_ROOT/sdk" "$@"
fi

if ! docker image inspect "$TOOLCHAIN_IMAGE" >/dev/null 2>&1; then
  warn "toolchain image $TOOLCHAIN_IMAGE missing – building it"
  "$LYNX_ROOT/scripts/build-toolchain-image.sh" >&2 || die "could not build $TOOLCHAIN_IMAGE"
fi

mounts=(-v "$LYNX_ROOT:/work")
case "$proj/" in
  "$LYNX_ROOT"/*) cdir="/work/${proj#"$LYNX_ROOT"/}" ;;
  *)            cdir="/project"; mounts+=(-v "$proj:/project") ;;
esac
tty=(); [ -t 0 ] && [ -t 1 ] && tty=(-t)
exec docker run --rm ${tty[@]+"${tty[@]}"} -u "$(id -u):$(id -g)" -e HOME=/tmp \
  -e LYNX_SDK=/work/sdk "${mounts[@]}" -w "$cdir" "$TOOLCHAIN_IMAGE" make "$@"
