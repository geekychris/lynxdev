@@ -248,6 +251,11 @@ class C65C02
          //
          if(gSystemCPUSleep) return;
 
+#ifdef LYNXH
+         // lynxh harness: breakpoints, steps, frame boundaries (lynxh.h).
+         // A non-zero return stops before this instruction (PC unchanged).
+         if(gLynxhCpuCheck && LYNXH_CpuHook(mPC)) return;
+#endif
          // Fetch opcode
          mOpcode=CPU_PEEK(mPC);
          mPC++;
